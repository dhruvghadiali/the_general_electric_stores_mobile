# Copy to .env and fill in per environment. .env is gitignored.
APP_ENV=development

# SIT, hosted on Render. No version prefix — every route is role-scoped:
#   POST /super-admin/signin
#   POST /employee/signin
#   POST /warehouse-manager/signin
API_BASE_URL=https://the-general-electric-stores-api-sit.onrender.com

# Render's free tier sleeps after ~15 minutes idle and takes 30-60s to wake.
# The first request of a session eats that, so the receive timeout is generous.
API_CONNECT_TIMEOUT_MS=30000
API_RECEIVE_TIMEOUT_MS=60000

ENABLE_HTTP_LOGS=true
